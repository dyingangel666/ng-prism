{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        // Jest is installed at the repo root; jest.config.cjs reaches it via
        // ../node_modules. @types/jest resolves from there too, so it is not
        // in test-workspace/package.json.
        "types": ["jest", "node"]
    },
    // tsconfig.json excludes *.spec.ts so the workspace config (which has no
    // test types) doesn't claim the specs. `exclude` is inherited by extending
    // configs, so it must be cleared here; otherwise this config would match
    // no files and report 0 errors.
    "exclude": [],
    "include": ["projects/**/*.spec.ts", "projects/**/*.d.ts"]
}
